PORT=3000
DATABASE_URL=postgresql://alicia:yourpassword@localhost:5432/MuroInvetory
JWT_SECRET=change-this-to-a-long-random-string
# DB_TIMEZONE=America/Mexico_City

# CORS: comma-separated list of allowed frontend origins (exact matches).
#   dev:  http://localhost:5173
#   prod: https://<your-frontend>.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# httpOnly cookie flags. Cross-site deployments (Vercel frontend + Render API)
# require secure=true and sameSite=none in production.
#   dev:  COOKIE_SECURE=false  COOKIE_SAMESITE=lax
#   prod: COOKIE_SECURE=true   COOKIE_SAMESITE=none
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Env files: .env.dev (local) and .env.prod (Supabase). Selected via NODE_ENV.
#   npm run dev  -> NODE_ENV=dev  loads .env.dev
#   npm run prod -> NODE_ENV=prod loads .env.prod
# For Render deploys set these variables in the dashboard instead of a file.