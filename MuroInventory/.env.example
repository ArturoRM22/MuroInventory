# Base URL of the MuroInventory API (no trailing slash).
#   dev:  http://localhost:3000
#   prod: leave empty (VITE_API_URL=) so requests are same-origin and go through
#         the Vercel /api proxy (see vercel.json). This keeps the auth cookie
#         first-party and working on all browsers (incl. iPhone Safari).
VITE_API_URL=http://localhost:3000

# Env files: .env.dev (local) and .env.prod (Vercel/Render). Selected via --mode.
#   pnpm dev   -> vite --mode dev  loads .env.dev
#   pnpm build -> vite build --mode prod loads .env.prod
# For Vercel deploys do NOT set VITE_API_URL in the dashboard (it would override
# .env.prod and bypass the proxy).